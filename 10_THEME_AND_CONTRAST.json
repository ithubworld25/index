{
  "version": "1.0.0",
  "targets": {
    "normal_text": 4.5,
    "large_text_and_ui": 3.0
  },
  "light": {
    "bg": "#F3F5F8",
    "panel": "#FFFFFF",
    "panel_alt": "#F8FAFC",
    "text": "#172033",
    "muted": "#536174",
    "subtle": "#667085",
    "border": "#94A3B8",
    "input_bg": "#FFFFFF",
    "accent": "#2563EB",
    "danger_text": "#991B1B",
    "danger_bg": "#FEE2E2",
    "warning_text": "#854D0E",
    "warning_bg": "#FEF3C7",
    "normalized_text": "#475569",
    "normalized_bg": "#E2E8F0",
    "disabled_text": "#667085",
    "placeholder": "#667085"
  },
  "dark": {
    "bg": "#070B14",
    "panel": "#0F172A",
    "panel_alt": "#111C30",
    "text": "#F8FAFC",
    "muted": "#CBD5E1",
    "subtle": "#A8B3C7",
    "border": "#64748B",
    "input_bg": "#111827",
    "accent": "#60A5FA",
    "danger_text": "#FCA5A5",
    "danger_bg": "#3F151B",
    "warning_text": "#FCD34D",
    "warning_bg": "#3A2A0A",
    "normalized_text": "#E2E8F0",
    "normalized_bg": "#334155",
    "disabled_text": "#94A3B8",
    "placeholder": "#A8B3C7"
  },
  "competency_colors": {
    "rule": "Идентификатор компетенции сохраняет hue; для тёмной темы допускается увеличение lightness или яркости без изменения смысловой идентичности",
    "light_theme_recommended_lightness_percent": [38, 48],
    "dark_theme_recommended_lightness_percent": [64, 76],
    "chip_text_rule": "Текст или обводка метки должны иметь контраст не ниже 3:1 относительно фона",
    "never": "Не использовать цвет как единственный носитель смысла"
  },
  "required_contrast_pairs": [
    ["light.text", "light.panel", 4.5],
    ["light.muted", "light.panel", 4.5],
    ["light.subtle", "light.panel", 4.5],
    ["dark.text", "dark.panel", 4.5],
    ["dark.muted", "dark.panel", 4.5],
    ["dark.subtle", "dark.panel", 4.5],
    ["dark.placeholder", "dark.input_bg", 4.5],
    ["dark.danger_text", "dark.danger_bg", 4.5],
    ["dark.warning_text", "dark.warning_bg", 4.5],
    ["dark.normalized_text", "dark.normalized_bg", 4.5],
    ["dark.border", "dark.bg", 3.0]
  ],
  "mandatory_manual_checks": [
    "основной текст",
    "вторичный текст",
    "служебный текст",
    "placeholder",
    "disabled",
    "кнопки",
    "поля ввода",
    "вкладки",
    "карточки дисциплин",
    "карточки ошибок",
    "серые нормализованные статусы",
    "метки компетенций",
    "линии на фоне карты"
  ]
}
